<odoo>
    <record id="view_variant_selection_wizard" model="ir.ui.view">
        <field name="name">variant.selection.wizard.form</field>
        <field name="model">variant.selection.wizard</field>
        <field name="arch" type="xml">

            <form string="Variant wise Report">

                <group>
                    <field name="pricelist_id" readonly="1"/>
                    <field name="product_ids" widget="many2many_tags"/>
                </group>

                <separator string="DETAILS"/>

                <group>
                    <field name="pricelist_name"/>
                    <field name="customer_name"/>
                    <field name="document_no"/>
                    <field name="quantity_ids"/>
                </group>

                <footer>
                    <button name="action_preview"
                            type="object"
                            string="Preview"
                            class="btn-primary"/>

                    <button name="action_print_pdf"
                            type="object"
                            string="Download"
                            class="btn-success"/>

                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>

            </form>

        </field>
    </record>
</odoo>