<odoo>
    <record id="view_save_pricelist_wizard" model="ir.ui.view">
        <field name="name">save.pricelist.wizard.form</field>
        <field name="model">save.pricelist.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Pricelist">

                <group>
                    <field name="print_type" widget="radio"/>
                </group>

                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Print"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>

            </form>
        </field>
    </record>
</odoo>
