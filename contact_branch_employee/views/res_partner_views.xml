<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===========================================================
         Partner Form
    ============================================================ -->

    <record id="view_partner_form_inherit_hq_branch" model="ir.ui.view">
        <field name="name">res.partner.form.hq.branch</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='image_1920']" position="replace">
                <field name="image_1920"
                       widget="contact_image"
                       options="{'preview_image':'avatar_128','size':[130,130]}"/>
            </xpath>
            <xpath expr="//sheet/group/group" position="inside">
                <separator string="Organization"/>
                <field name="is_headquarter"/>
                <field name="is_branch" readonly="1"/>
                <field name="headquarter_id"
                       invisible="is_headquarter"
                       domain="[('is_headquarter','=',True)]"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Branches">
                    <field name="branch_ids"
                           mode="kanban"
                           context="{
                               'default_headquarter_id': id

                           }">
                        <!-- ==========================================
                             Kanban
                        =========================================== -->
                        <kanban class="o_kanban_mobile">
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="function"/>
                            <field name="image_1920"/>
                            <templates>
                                <t t-name="card">
                                    <div class="oe_kanban_global_click d-flex align-items-center p-3">

                                        <!-- Image -->
                                        <div class="me-3">
                                            <t t-if="record.image_1920.raw_value">
                                                <img
                                                        t-att-src="kanban_image('res.partner','avatar_128',record.id.raw_value)"
                                                        alt="Branch Contact"
                                                        style="width:95px;height:95px;object-fit:cover;border-radius:0;"/>
                                            </t>
                                            <t t-else="">
                                                <div style="width:95px;
                                height:95px;
                                background:#875A7B;
                                color:white;
                                display:flex;
                                align-items:center;
                                justify-content:center;
                                font-size:32px;
                                font-weight:bold;">
                                                    <t t-esc="record.name.value ? record.name.value.charAt(0).toUpperCase() : '?'"/>
                                                </div>
                                            </t>
                                        </div>

                                        <!-- Details -->
                                        <div class="flex-grow-1">

                                            <!-- Name + Open Icon -->
                                            <div class="d-flex align-items-center">
                                                <strong class="fs-5 me-2">
                                                    <field name="name"/>
                                                </strong>

                                                <button type="object"
                                                        name="action_open_full_form"
                                                        class="btn btn-link p-0 border-0 shadow-none"
                                                        title="Open Contact">
                                                    <i class="fa fa-external-link"/>
                                                </button>
                                            </div>

                                            <!-- Email -->
                                            <div t-if="record.email.raw_value">
                                                <i class="fa fa-envelope text-primary me-1" title="Email"/>
                                                <field name="email"/>
                                            </div>

                                            <div t-if="record.phone.raw_value">
                                                <i class="fa fa-phone text-primary me-1" title="Phone"/>
                                                <field name="phone"/>
                                            </div>

                                            <div t-if="record.function.raw_value">
                                                <i class="fa fa-briefcase text-primary me-1" title="Job Position"/>
                                                <field name="function"/>
                                            </div>

                                        </div>

                                    </div>
                                </t>
                            </templates>
                        </kanban>
                        <!-- ==========================================
                             Embedded Form
                             (Continue in Part 2)
                        =========================================== -->
                        <form string="Branch">
                            <sheet>
                                <group>
                                    <field name="company_type"
                                           widget="radio"
                                           options="{'horizontal': true}"/>
                                </group>
                                <!-- ===========================
                                     Person
                                ============================ -->
                                <group col="2"
                                       invisible="company_type == 'company'">
                                    <group>
                                        <field name="image_1920"
                                               widget="contact_image"
                                               options="{'size':[90,90]}"/>
                                    </group>
                                    <group>
                                        <field name="name" placeholder="Employee / Contact Name"/>
                                        <field name="email"/>
                                        <field name="phone"/>
<!--                                        <field name="mobile"/>-->
                                        <field name="function"/>
                                        <field name="comment"/>
                                    </group>
                                </group>
                                <!-- ===========================
                                     Company / Branch
                                ============================ -->
                                <group col="2" invisible="company_type == 'person'">
                                    <group>
                                        <field name="image_1920"
                                               widget="contact_image"
                                               options="{'size':[90,90]}"/>
                                    </group>
                                    <group>
                                        <field name="name"/>
                                        <field name="email"/>
                                        <field name="phone"/>
                                        <field name="street"/>
                                        <field name="city"/>
                                        <field name="country_id"/>
                                        <field name="is_branch"/>
                                    </group>
                                </group>
                                <!-- Hidden Fields -->
                                <group invisible="1">
                                    <field name="is_branch"/>
                                    <field name="headquarter_id"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>


